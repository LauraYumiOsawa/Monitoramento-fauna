# Serviço systemd da versão 04a (Raspberry Pi 5 + AI Camera (IMX500) · YOLOv8n multiclasse (Modelo A) · IMX500 (rede no sensor, INT8) via Picamera2) — arquitetura de energia A.
# Instalação (no dispositivo, com o pacote em /opt/armadilha/04a):
#   sudo cp armadilha.service /etc/systemd/system/armadilha-04a.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now armadilha-04a
[Unit]
Description=Armadilha fotográfica com IA local — versão 04a
After=multi-user.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/armadilha/04a
ExecStart=/opt/armadilha/04a/executar.sh trap
Restart=on-failure
RestartSec=10
# A câmera e o GPIO exigem os grupos video e gpio.
SupplementaryGroups=video gpio

[Install]
WantedBy=multi-user.target
