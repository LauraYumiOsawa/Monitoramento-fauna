# Serviço systemd da versão 13b (NVIDIA Jetson Orin Nano Super · Modelo B — YOLOv8n presença (416) + MobileNetV2 (128) · ONNX Runtime GPU + TensorRT EP (FP16)) — arquitetura de energia A.
# Instalação (no dispositivo, com o pacote em /opt/armadilha/13b):
#   sudo cp armadilha.service /etc/systemd/system/armadilha-13b.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now armadilha-13b
[Unit]
Description=Armadilha fotográfica com IA local — versão 13b
After=multi-user.target

[Service]
Type=simple
User=jetson
WorkingDirectory=/opt/armadilha/13b
ExecStart=/opt/armadilha/13b/executar.sh trap
Restart=on-failure
RestartSec=10
# A câmera e o GPIO exigem os grupos video e gpio.
SupplementaryGroups=video gpio

[Install]
WantedBy=multi-user.target
