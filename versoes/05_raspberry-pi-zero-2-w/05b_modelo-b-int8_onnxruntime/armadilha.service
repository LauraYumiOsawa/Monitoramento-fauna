# Serviço systemd da versão 05b (Raspberry Pi Zero 2 W · Modelo B — YOLOv8n presença (416) + MobileNetV2 (128) · ONNX Runtime (CPU, INT8)) — arquitetura de energia A.
# Instalação (no dispositivo, com o pacote em /opt/armadilha/05b):
#   sudo cp armadilha.service /etc/systemd/system/armadilha-05b.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now armadilha-05b
[Unit]
Description=Armadilha fotográfica com IA local — versão 05b
After=multi-user.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/armadilha/05b
ExecStart=/opt/armadilha/05b/executar.sh trap
Restart=on-failure
RestartSec=10
# A câmera e o GPIO exigem os grupos video e gpio.
SupplementaryGroups=video gpio

[Install]
WantedBy=multi-user.target
