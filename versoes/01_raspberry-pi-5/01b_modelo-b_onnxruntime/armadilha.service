# Serviço systemd da versão 01b (Raspberry Pi 5 · Modelo B — YOLOv8n presença (416) + MobileNetV2 (128) · ONNX Runtime (CPU, FP32)) — arquitetura de energia A.
# Instalação (no dispositivo, com o pacote em /opt/armadilha/01b):
#   sudo cp armadilha.service /etc/systemd/system/armadilha-01b.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now armadilha-01b
[Unit]
Description=Armadilha fotográfica com IA local — versão 01b
After=multi-user.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/armadilha/01b
ExecStart=/opt/armadilha/01b/executar.sh trap
Restart=on-failure
RestartSec=10
# A câmera e o GPIO exigem os grupos video e gpio.
SupplementaryGroups=video gpio

[Install]
WantedBy=multi-user.target
