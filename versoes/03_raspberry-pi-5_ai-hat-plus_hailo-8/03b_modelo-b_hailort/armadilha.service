# Serviço systemd da versão 03b (Raspberry Pi 5 + AI HAT+ 26 TOPS (Hailo-8) · Modelo B — YOLOv8n presença (416) + MobileNetV2 (128) · HailoRT (detector HEF) + ONNX Runtime (classificador)) — arquitetura de energia A.
# Instalação (no dispositivo, com o pacote em /opt/armadilha/03b):
#   sudo cp armadilha.service /etc/systemd/system/armadilha-03b.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now armadilha-03b
[Unit]
Description=Armadilha fotográfica com IA local — versão 03b
After=multi-user.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/armadilha/03b
ExecStart=/opt/armadilha/03b/executar.sh trap
Restart=on-failure
RestartSec=10
# A câmera e o GPIO exigem os grupos video e gpio.
SupplementaryGroups=video gpio

[Install]
WantedBy=multi-user.target
