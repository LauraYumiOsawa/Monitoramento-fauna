# Serviço systemd da versão 12a (Raspberry Pi 5 + AI HAT+ 2 (Hailo-10H) · YOLOv8n multiclasse (Modelo A) · HailoRT 5 (HEF hailo10h)) — arquitetura de energia A.
# Instalação (no dispositivo, com o pacote em /opt/armadilha/12a):
#   sudo cp armadilha.service /etc/systemd/system/armadilha-12a.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now armadilha-12a
[Unit]
Description=Armadilha fotográfica com IA local — versão 12a
After=multi-user.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/armadilha/12a
ExecStart=/opt/armadilha/12a/executar.sh trap
Restart=on-failure
RestartSec=10
# A câmera e o GPIO exigem os grupos video e gpio.
SupplementaryGroups=video gpio

[Install]
WantedBy=multi-user.target
